---
import BaseLayout from "@/layouts/BaseLayout.astro";
import data from "@/data/data.json";
import { collections, heroSlides, testimonials, thumbOf } from "@/data/catalog";
import { ArrowRight, ArrowLeft, ArrowUpRight, Grid2X2, CircleHelp, MessageCircle, X, Plus } from "lucide-react";

const SITE = Astro.site ?? new URL("https://studioohana.com");
const digits = data.company.contact.phone.replace(/\D/g, "");
const localNumber = digits.slice(-10);
const phoneDisplay = `${localNumber.slice(0, 3)} ${localNumber.slice(3, 6)} ${localNumber.slice(6)}`;
const whatsappBase = `https://wa.me/${digits}`;
const wa = (message: string) => `${whatsappBase}?text=${encodeURIComponent(message)}`;
const waGeneral = wa("Hola, Studio Ohana. Me gustaría cotizar un producto personalizado.");

const showTestimonials = testimonials.length > 0;

const faq = [
  { q: "¿Cómo hago mi pedido?", a: "Envíanos por WhatsApp el producto, la cantidad y la fecha en que lo necesitas." },
];

const galleryPayload = {
  site: SITE.origin,
  whatsapp: whatsappBase,
  collections: Object.fromEntries(collections.map((collection) => [collection.id, { label: collection.label, items: collection.items.map(({ src, thumb, alt, label }) => ({ src, thumb, alt, label })) }])),
  testimonials: { label: "Clientes", items: testimonials.map(({ src, alt, caption }) => ({ src, thumb: src, alt, label: caption ?? "Cliente de Studio Ohana" })) },
};
const year = new Date().getFullYear();
---

<BaseLayout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <header class="site-header" id="site-header">
    <nav class="glass-nav" id="main-nav" aria-label="Navegación principal">
      <a href="#inicio" data-nav="inicio" class="nav-home is-active" aria-label="Studio Ohana, inicio" aria-current="location"><span class="nav-logo"><img src={data.company.logo} alt="" width="2000" height="2000" /></span></a>
      <a href="#catalogo" data-nav="catalogo" aria-label="Catálogo"><Grid2X2 size={19} strokeWidth={1.5} /><span>Catálogo</span></a>
      <a href="#preguntas" data-nav="preguntas" aria-label="Preguntas frecuentes"><CircleHelp size={19} strokeWidth={1.5} /><span>Preguntas</span></a>
      <a href={waGeneral} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp"><MessageCircle size={19} strokeWidth={1.5} /><span>WhatsApp</span></a>
    </nav>
  </header>

  <main id="contenido">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title"><span class="hero-names">{heroSlides.map((slide, index) => <span class:list={["hero-name", { "is-active": index === 0 }]} data-hero-name={index} aria-hidden={index !== 0}>{slide.name}</span>)}</span><em>con tu diseño.</em></h1>
        <p class="hero-lead">Playeras, tazas, termos y más, personalizados con tu diseño.</p>
        <div class="hero-actions">
<a class="button button-ghost" href="#catalogo">Ver catálogo <ArrowRight size={17} /></a>
        </div>

      </div>

      <div class="hero-visual">
        <span class="hero-disc" aria-hidden="true"></span>
        {heroSlides.map((slide, index) => (
          <div class:list={["hero-slide", { "is-active": index === 0 }]} data-hero-slide={index} aria-hidden={index !== 0}>
            <figure class="hero-card hero-card-back"><img src={thumbOf(slide.back.src)} alt="" width="640" height={Math.round(640 * slide.back.height / slide.back.width)} /></figure>
            <figure class="hero-card hero-card-side"><img src={thumbOf(slide.side.src)} alt="" width="640" height={Math.round(640 * slide.side.height / slide.side.width)} /></figure>
            <figure class="hero-main"><img src={thumbOf(slide.main.src)} alt={slide.name + " de Studio Ohana"} width={slide.main.width} height={slide.main.height} fetchpriority={index === 0 ? "high" : "auto"} /></figure>
          </div>
        ))}
      </div>
    </section>

    <section class="section catalog" id="catalogo" aria-labelledby="catalog-title">
      <header class="section-head" data-reveal>
        <h2 id="catalog-title">Nuestros <em>productos</em></h2>
      </header>

      <div class="catalog-grid">
        {collections.map((collection, index) => (
          <button class:list={["collection-card", { "is-featured": index === 0 }]} type="button" data-collection={collection.id} data-reveal aria-label={`Ver galería de ${collection.label}, ${collection.items.length} trabajos`}>
            <span class="card-media" aria-hidden="true">
              {collection.items.slice(0, 3).map((item, previewIndex) => (
                <span class={`fan fan-${previewIndex + 1}`}><img src={item.thumb} alt="" width="640" height={Math.round(640 * item.height / item.width)} loading={index < 3 ? "eager" : "lazy"} decoding="async" /></span>
              ))}
            </span>
            <span class="card-body">
              <span class="card-title">{collection.label}</span>
            </span>
          </button>
        ))}

      </div>
    </section>

    {showTestimonials && (
      <section class="section testimonials" id="clientes" aria-labelledby="testimonials-title">
        <header class="section-head" data-reveal>
            <h2 id="testimonials-title">Lo que dicen <em>nuestros clientes</em></h2>
          </header>
        {(
          <div class="proof-wall">
            {testimonials.map((item, index) => (
              <button class="proof-card" type="button" data-testimonial={index} data-reveal aria-label={`Ampliar testimonio ${index + 1} de ${testimonials.length}`}>
                <img src={item.src} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" />
                {item.caption && <span class="proof-caption">{item.caption}</span>}
              </button>
            ))}
          </div>
        )}
      </section>
    )}

    <section class="section faq" id="preguntas" aria-labelledby="faq-title">
      <header class="section-head faq-head" data-reveal>
        <h2 id="faq-title">Preguntas frecuentes</h2>
      </header>
      <div class="faq-list">
        {faq.map((item) => (
          <details class="faq-item" name="preguntas" data-reveal>
            <summary><span>{item.q}</span><span class="faq-icon" aria-hidden="true"><Plus size={18} /></span></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

  </main>

  <footer class="site-footer" id="contacto">
    <div class="footer-panel">
      <div class="footer-top">
        <a class="footer-brand" href="#inicio" aria-label="Studio Ohana, inicio"><span class="nav-logo"><img src={data.company.logo} alt="Logo de Studio Ohana" width="2000" height="2000" loading="lazy" /></span><span>Studio Ohana</span></a>
        <nav class="footer-links" aria-label="Secciones"><a href="#catalogo">Catálogo</a><a href="#preguntas">Preguntas frecuentes</a></nav>
        <div class="footer-contact">
          <a class="footer-whatsapp" href={waGeneral} target="_blank" rel="noopener noreferrer">WhatsApp <ArrowUpRight size={19} /></a>
          <span>{phoneDisplay}</span>
          <a href={data.company.contact.social.facebook} target="_blank" rel="noopener noreferrer">Facebook <ArrowUpRight size={15} /></a>
        </div>
      </div>
      <div class="footer-wordmark" aria-hidden="true">ohana</div>
    </div>
    <div class="footer-bottom">
      <p>© {year} Studio Ohana</p>
      <div class="footer-meta-actions">
        <a class="footer-credit" href="https://santsystems.com/" target="_blank" rel="noopener noreferrer">created by <span>santsystems.com</span></a>
        <a href="#inicio" aria-label="Volver al inicio"><ArrowUpRight size={18} /></a>
      </div>
    </div>
  </footer>

  <dialog class="viewer" id="viewer" aria-labelledby="viewer-title">
    <div class="viewer-head">
      <div>
        <p class="viewer-sub" id="viewer-sub"></p>
        <h3 class="viewer-title" id="viewer-title"></h3>
      </div>
      <button class="icon-button viewer-close" type="button" aria-label="Cerrar galería"><X size={20} /></button>
    </div>
    <div class="viewer-stage">
      <button class="icon-button viewer-arrow viewer-prev" type="button" aria-label="Trabajo anterior"><ArrowLeft size={20} /></button>
      <figure class="viewer-figure"><img class="viewer-image" alt="" /></figure>
      <button class="icon-button viewer-arrow viewer-next" type="button" aria-label="Trabajo siguiente"><ArrowRight size={20} /></button>
    </div>
    <div class="viewer-foot">
      <p class="viewer-count" aria-live="polite"></p>
      <div class="viewer-thumbs" aria-label="Trabajos de la galería"></div>
      <a class="viewer-cta" target="_blank" rel="noopener noreferrer"><span class="viewer-cta-label">Consultar por WhatsApp</span><ArrowUpRight size={17} /></a>
    </div>
  </dialog>

  <script id="gallery-data" type="application/json" set:html={JSON.stringify(galleryPayload)} is:inline></script>

  <script>
    type Item = { src: string; thumb: string; alt: string; label: string };
    type Gallery = { label: string; items: Item[] };
    const payload = JSON.parse(document.getElementById("gallery-data")?.textContent ?? "{}") as { site: string; whatsapp: string; collections: Record<string, Gallery>; testimonials: Gallery };
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    /* Producto y título comparten el mismo cambio de estado. */
    const heroSection = document.getElementById("inicio");
    const heroSlides = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-slide]"));
    const heroNames = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-name]"));
    let heroIndex = 0;
    let heroInView = true;
    let heroTimer: ReturnType<typeof setTimeout> | undefined;
    function scheduleHero() {
      clearTimeout(heroTimer);
      const paused = reduceMotion.matches;
      if (paused || !heroInView || document.hidden || document.documentElement.classList.contains("has-modal")) return;
      heroTimer = setTimeout(() => {
        heroIndex = (heroIndex + 1) % heroSlides.length;
        [heroSlides, heroNames].forEach((elements) => elements.forEach((element, index) => {
          const active = index === heroIndex;
          element.classList.toggle("is-active", active);
          element.setAttribute("aria-hidden", String(!active));
        }));
        scheduleHero();
      }, 4500);
    }
    document.addEventListener("visibilitychange", scheduleHero);
    reduceMotion.addEventListener("change", scheduleHero);
    const heroObserver = new IntersectionObserver(([entry]) => { heroInView = entry.isIntersecting; scheduleHero(); }, { threshold: .2 });
    if (heroSection) heroObserver.observe(heroSection);
    scheduleHero();

    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav]"));
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => {
          const active = link.dataset.nav === entry.target.id;
          link.classList.toggle("is-active", active);
          if (active) link.setAttribute("aria-current", "location"); else link.removeAttribute("aria-current");
        });
      });
    }, { rootMargin: "-45% 0px -50% 0px" });
    navLinks.forEach((link) => { const section = document.getElementById(link.dataset.nav ?? ""); if (section) sectionObserver.observe(section); });

    /* Aparición al desplazarse */
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        revealObserver.unobserve(entry.target);
      });
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
    document.querySelectorAll("[data-reveal]").forEach((element, index) => {
      (element as HTMLElement).style.setProperty("--reveal-delay", `${(index % 4) * 70}ms`);
      revealObserver.observe(element);
    });

    /* Galería */
    const viewer = document.getElementById("viewer") as HTMLDialogElement | null;
    const image = viewer?.querySelector<HTMLImageElement>(".viewer-image");
    const title = viewer?.querySelector<HTMLElement>(".viewer-title");
    const subtitle = viewer?.querySelector<HTMLElement>(".viewer-sub");
    const count = viewer?.querySelector<HTMLElement>(".viewer-count");
    const thumbs = viewer?.querySelector<HTMLElement>(".viewer-thumbs");
    const cta = viewer?.querySelector<HTMLAnchorElement>(".viewer-cta");
    const ctaLabel = viewer?.querySelector<HTMLElement>(".viewer-cta-label");
    let gallery: Gallery | null = null;
    let galleryKind: "product" | "testimonial" = "product";
    let index = 0;

    function preload(src: string) { const img = new Image(); img.src = src; }

    function render(direction = 0) {
      if (!gallery || !image) return;
      const item = gallery.items[index];
      const total = gallery.items.length;
      image.src = item.src;
      image.alt = item.alt;
      if (title) title.textContent = item.label;
      if (subtitle) subtitle.textContent = galleryKind === "testimonial" ? "Testimonios" : gallery.label === item.label ? "Catálogo" : gallery.label;
      if (count) count.textContent = `${index + 1} de ${total}`;
      if (cta) {
        const message = galleryKind === "product"
          ? `Hola, Studio Ohana. Me interesa cotizar algo como este trabajo de ${item.label.toLowerCase()} que vi en su galería: ${payload.site}${item.src}`
          : "Hola, Studio Ohana. Vi los testimonios de sus clientes y me gustaría cotizar un producto personalizado.";
        cta.href = `${payload.whatsapp}?text=${encodeURIComponent(message)}`;
      }
      if (ctaLabel) ctaLabel.textContent = galleryKind === "product" ? "Consultar por WhatsApp" : "WhatsApp";
      thumbs?.querySelectorAll<HTMLButtonElement>("button").forEach((thumb, thumbIndex) => {
        const active = thumbIndex === index;
        thumb.classList.toggle("is-active", active);
        if (active) {
          thumb.setAttribute("aria-current", "true");
          thumb.scrollIntoView({ block: "nearest", inline: "center", behavior: reduceMotion.matches ? "auto" : "smooth" });
        } else thumb.removeAttribute("aria-current");
      });
      if (total > 1) {
        preload(gallery.items[(index + 1) % total].src);
        preload(gallery.items[(index - 1 + total) % total].src);
      }
      if (direction && !reduceMotion.matches) {
        image.animate([{ opacity: 0, transform: `translateX(${direction * 28}px) scale(.98)` }, { opacity: 1, transform: "none" }], { duration: 420, easing: "cubic-bezier(.2,.8,.2,1)" });
      }
    }

    function go(step: number) {
      if (!gallery || gallery.items.length < 2) return;
      index = (index + step + gallery.items.length) % gallery.items.length;
      render(step);
    }

    function open(next: Gallery, kind: "product" | "testimonial", start = 0) {
      if (!viewer || !thumbs) return;
      gallery = next;
      galleryKind = kind;
      index = start;
      viewer.classList.toggle("is-single", next.items.length < 2);
      viewer.classList.toggle("is-testimonial", kind === "testimonial");
      thumbs.replaceChildren(...next.items.map((item, itemIndex) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "viewer-thumb";
        button.setAttribute("aria-label", `Ver trabajo ${itemIndex + 1}`);
        const img = document.createElement("img");
        img.src = item.thumb;
        img.alt = "";
        img.decoding = "async";
        button.append(img);
        button.addEventListener("click", () => { const step = itemIndex > index ? 1 : -1; index = itemIndex; render(step); });
        return button;
      }));
      viewer.showModal();
      document.documentElement.classList.add("has-modal");
      render();
    }

    document.querySelectorAll<HTMLButtonElement>("[data-collection]").forEach((card) => {
      card.addEventListener("click", () => {
        const collection = payload.collections[card.dataset.collection ?? ""];
        if (collection) open(collection, "product");
      });
    });
    document.querySelectorAll<HTMLButtonElement>("[data-testimonial]").forEach((card) => {
      card.addEventListener("click", () => open(payload.testimonials, "testimonial", Number(card.dataset.testimonial)));
    });

    viewer?.querySelector(".viewer-prev")?.addEventListener("click", () => go(-1));
    viewer?.querySelector(".viewer-next")?.addEventListener("click", () => go(1));
    viewer?.querySelector(".viewer-close")?.addEventListener("click", () => viewer.close());
    viewer?.addEventListener("close", () => document.documentElement.classList.remove("has-modal"));
    viewer?.addEventListener("click", (event) => { if (event.target === viewer) viewer.close(); });
    viewer?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") go(1);
      if (event.key === "ArrowLeft") go(-1);
    });
    let touchX = 0;
    const stage = viewer?.querySelector<HTMLElement>(".viewer-stage");
    stage?.addEventListener("touchstart", (event) => { touchX = event.changedTouches[0]?.clientX ?? 0; }, { passive: true });
    stage?.addEventListener("touchend", (event) => {
      const delta = (event.changedTouches[0]?.clientX ?? touchX) - touchX;
      if (Math.abs(delta) > 45) go(delta < 0 ? 1 : -1);
    }, { passive: true });
  </script>
</BaseLayout>
