---
import BaseLayout from "@/layouts/BaseLayout.astro";
import data from "@/data/data.json";
import gallery from "@/data/product-gallery.json";
import { ArrowDown, ArrowRight, ArrowUpRight, AtSign, Globe2 } from "lucide-react";

const categoryLabels: Record<string, string> = {
  bolsas: "Bolsas",
  cuadros: "Cuadros",
  "disenos-y-marca": "Diseños y marca",
  etiquetas: "Etiquetas",
  globos: "Globos",
  kits: "Kits de regalo",
  papeleria: "Papelería",
  playeras: "Playeras",
  "regalos-y-arreglos": "Regalos y arreglos",
  stickers: "Stickers",
  tazas: "Tazas",
  termos: "Termos",
  vasos: "Vasos",
  "vinilos-textiles": "Vinilos textiles",
};
const categories = [...new Set(gallery.map((item) => item.category))];
const overview = categories.map((category) => gallery.find((item) => item.category === category)!);
const overviewIds = new Set(overview.map((item) => item.id));
const orderedGallery = [...overview, ...gallery.filter((item) => !overviewIds.has(item.id))];
const heroImage = gallery.find((item) => item.id === 102) ?? gallery[0];
const instagram = data.company.contact.social.instagram;
const facebook = data.company.contact.social.facebook;
---

<BaseLayout>
  <div class="site-shell" id="inicio">
    <header class="topbar">
      <a class="brand" href="#inicio" aria-label="Studio Ohana, inicio">
        <img src={data.company.logo} alt="" width="48" height="48" />
        <span><small>studio</small> ohana</span>
      </a>
      <a class="topbar-link" href="#productos">Explorar productos <ArrowDown size={15} /></a>
    </header>

    <main>
      <section class="hero section-wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-dot"></span> Sublimación y productos personalizados</p>
          <h1 id="hero-title">Tu idea,<br /><span>con tu diseño.</span></h1>
          <p class="hero-description">Playeras, tazas, termos y detalles personalizados para regalar, celebrar o representar tu marca.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#productos">Ver productos <ArrowRight size={17} /></a>
            <a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">Cuéntanos tu idea <ArrowUpRight size={16} /></a>
          </div>
          <p class="hero-note">Diseños para pedidos personales, eventos y negocios.</p>
        </div>
        <figure class="hero-photo">
          <img src={heroImage.src} alt="Playera negra personalizada con diseño tricolor" width={heroImage.width} height={heroImage.height} fetchpriority="high" />
          <figcaption><span>01</span><span>Una idea se vuelve producto</span><span>Studio Ohana</span></figcaption>
        </figure>
        <a class="scroll-cue" href="#productos" aria-label="Bajar a productos"><span>Desliza para explorar</span><ArrowDown size={15} /></a>
      </section>

      <section class="intro-band section-wrap" aria-label="Acerca de Studio Ohana">
        <p>Personalizamos productos para que cada pedido tenga algo propio: un nombre, una fecha, una idea o una imagen que quieras llevar contigo.</p>
        <span>Hecho en México <span aria-hidden="true">·</span> @stdohana</span>
      </section>

      <section class="products-section section-wrap" id="productos" aria-labelledby="products-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Lo que hacemos</p>
            <h2 id="products-title">Productos <span>con intención.</span></h2>
          </div>
          <p class="section-copy">Explora las categorías y encuentra una idea para tu siguiente pedido.</p>
        </div>

        <div class="gallery-filters" role="group" aria-label="Filtrar productos por categoría">
          <button class="filter-button is-active" type="button" data-category="all" aria-pressed="true">Todos</button>
          {categories.map((category) => (
            <button class="filter-button" type="button" data-category={category} aria-pressed="false">{categoryLabels[category] ?? category}</button>
          ))}
        </div>

        <div class="product-grid" id="product-grid">
          {orderedGallery.map((item, index) => (
            <a class="product-card" href={item.src} target="_blank" rel="noopener noreferrer" data-category={item.category} data-order={index} data-label={categoryLabels[item.category] ?? item.category}>
              <span class="product-photo"><img src={item.src} alt={item.alt} width={item.width} height={item.height} loading="lazy" /></span>
              <span class="product-meta"><span>{categoryLabels[item.category] ?? item.category}</span><ArrowUpRight size={15} /></span>
            </a>
          ))}
        </div>
        <button class="more-button" id="more-products" type="button">Ver más productos <ArrowDown size={15} /></button>
      </section>

      <section class="process-section">
        <div class="section-wrap process-inner">
          <div class="process-heading">
            <p class="eyebrow">Cómo pedir</p>
            <h2>De la idea<br />al producto.</h2>
            <p>Cuéntanos qué tienes en mente y revisamos juntos los detalles del pedido.</p>
          </div>
          <ol class="process-list">
            <li><span>01</span><div><h3>Comparte tu idea</h3><p>Envíanos el producto, diseño o referencia que te interesa.</p></div></li>
            <li><span>02</span><div><h3>Definimos los detalles</h3><p>Confirmamos personalización, cantidades y fecha de entrega.</p></div></li>
            <li><span>03</span><div><h3>Preparamos tu pedido</h3><p>Producimos tus artículos y coordinamos la entrega contigo.</p></div></li>
          </ol>
        </div>
      </section>

      <section class="contact-section section-wrap" id="contacto">
        <p class="eyebrow">¿Tienes una idea?</p>
        <div class="contact-row">
          <h2>Hagámosla<br /><span>producto.</span></h2>
          <div class="contact-action">
            <p>Escríbenos para consultar opciones, personalización y tiempos de entrega.</p>
            <a class="button button-dark" href={instagram} target="_blank" rel="noopener noreferrer">Contactar por Instagram <ArrowUpRight size={17} /></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer section-wrap">
      <a class="brand footer-brand" href="#inicio"><img src={data.company.logo} alt="" width="38" height="38" /><span><small>studio</small> ohana</span></a>
      <p>Productos personalizados, hechos a partir de tus ideas.</p>
      <div class="social-links">
        {instagram && <a href={instagram} aria-label="Instagram de Studio Ohana" target="_blank" rel="noopener noreferrer"><AtSign size={18} /></a>}
        {facebook && <a href={facebook} aria-label="Facebook de Studio Ohana" target="_blank" rel="noopener noreferrer"><Globe2 size={18} /></a>}
      </div>
      <small class="copyright">© {new Date().getFullYear()} Studio Ohana</small>
    </footer>

    <nav class="floating-nav" aria-label="Navegación principal">
      <a href="#inicio">Inicio</a>
      <a href="#productos">Productos</a>
      <a href="#contacto">Contacto</a>
      <a class="floating-nav-cta" href={instagram} target="_blank" rel="noopener noreferrer">Hablemos <ArrowUpRight size={14} /></a>
    </nav>
  </div>

  <script>
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".product-card"));
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-button"));
    const moreButton = document.querySelector<HTMLButtonElement>("#more-products");
    let activeCategory = "all";
    let expanded = false;
    const pageSize = 8;

    function renderProducts() {
      const matching = cards.filter((card) => activeCategory === "all" || card.dataset.category === activeCategory);
      cards.forEach((card) => {
        const position = matching.indexOf(card);
        card.hidden = position < 0 || (!expanded && position >= pageSize);
      });
      if (moreButton) {
        moreButton.hidden = matching.length <= pageSize;
        moreButton.innerHTML = expanded ? 'Mostrar menos <span aria-hidden="true">↑</span>' : `Ver ${matching.length - pageSize} productos más <span aria-hidden="true">↓</span>`;
      }
    }

    filters.forEach((button) => button.addEventListener("click", () => {
      activeCategory = button.dataset.category ?? "all";
      expanded = false;
      filters.forEach((filter) => {
        const selected = filter === button;
        filter.classList.toggle("is-active", selected);
        filter.setAttribute("aria-pressed", String(selected));
      });
      renderProducts();
    }));

    moreButton?.addEventListener("click", () => {
      expanded = !expanded;
      renderProducts();
    });

    renderProducts();
  </script>
</BaseLayout>
