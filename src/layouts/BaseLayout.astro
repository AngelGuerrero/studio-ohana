---
import data from "@/data/data.json";
import { collections } from "@/data/catalog";
import "@/styles/globals.css";

const seo = data.seo;
const siteTitle = seo.title || `${data.company.name} | Sublimación Personalizada`;
const siteDesc = seo.description || data.company.shortDescription;
const siteName = seo.siteName || data.company.name;
const locale = seo.locale || "es_MX";
const handle = data.company.contact.social.handle;
const twitterHandle = seo.twitterHandle || (handle ? `@${handle}` : "");

// El OG debe ser bitmap: los scrapers (WhatsApp, Facebook, X, LinkedIn) no
// rasterizan SVG. El .svg se mantiene como fuente editable del .png.
const ogImg = seo.ogImage || "/images/og-image.png";
const ogAlt = siteName;

// URLs absolutas (necesarias para canonical, OG y datos estructurados).
const SITE = Astro.site ?? new URL("https://studioohana.com");
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImgAbs = new URL(ogImg, SITE).href;
const logoAbs = new URL(data.company.logo, SITE).href;

// Datos estructurados: negocio local + catálogo de productos.
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${SITE.href}#business`,
  name: data.company.name,
  alternateName: handle ? [handle, `@${handle}`] : undefined,
  description: siteDesc,
  slogan: data.company.tagline || undefined,
  url: SITE.href,
  logo: logoAbs,
  image: ogImgAbs,
  telephone: data.company.contact.phone || undefined,
  email: data.company.contact.email || undefined,  address: data.company.contact.address
    ? { "@type": "PostalAddress", streetAddress: data.company.contact.address, addressCountry: "MX" }
    : undefined,
  sameAs: [
    data.company.contact.social.instagram,
    data.company.contact.social.facebook,
    data.company.contact.social.tiktok,
  ].filter(Boolean),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Productos personalizados",
    itemListElement: collections.map(({ label: name }) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Product", name },
    })),
  },
};

// Datos estructurados del sitio.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.href}#website`,
  url: SITE.href,
  name: siteName,
  alternateName: handle ? [handle, `@${handle}`] : undefined,
  description: siteDesc,
  inLanguage: "es-MX",
  publisher: { "@id": `${SITE.href}#business` },
};

---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDesc} />
    <meta name="author" content={siteName} />
    <meta name="publisher" content={siteName} />
    <meta name="application-name" content={siteName} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#fbf9f5" />

    <!-- Canonical + idioma + sitemap -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-MX" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo-mark.png" />
    <link rel="apple-touch-icon" href="/images/logo-mark.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDesc} />
    <meta property="og:image" content={ogImgAbs} />
    <meta property="og:image:secure_url" content={ogImgAbs} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(seo.ogImageWidth ?? 1200)} />
    <meta property="og:image:height" content={String(seo.ogImageHeight ?? 630)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDesc} />
    <meta name="twitter:image" content={ogImgAbs} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- Canales confirmados -->
    {data.company.contact.social.instagram && (
      <link rel="me" href={data.company.contact.social.instagram} />
    )}
    {data.company.contact.social.facebook && (
      <link rel="me" href={data.company.contact.social.facebook} />
    )}
    {data.company.contact.social.tiktok && (
      <link rel="me" href={data.company.contact.social.tiktok} />
    )}

    <!-- Datos estructurados (Schema.org) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{siteTitle}</title>
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
